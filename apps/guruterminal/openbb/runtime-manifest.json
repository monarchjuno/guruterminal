  "uv_lock_sha256": "f55253263f4fd5ba931f16b45935d3ca3ea4113def7d3b554c49f3bf48df7b02",
  "packages": {
    "openbb": "4.7.2",
    "openbb-mcp-server": "1.4.1"
  },
  "protocol": {
    "transport": "stdio",
    "bootstrap_type": "guruterminal.bootstrap",
    "bootstrap_version": 1,
    "bootstrap_max_bytes": 65536,
    "initial_tools": "admin_only",
    "control_tool_names": [
      "activate_category",
      "activate_tools",
      "available_categories",
      "available_tools",
      "deactivate_tools"
    ],
    "provider_receipt_pointer": "/structuredContent/provider",
    "tool_activation": {
      "tool_name": "activate_tools",
      "argument_name": "tool_names"
    }
  },
  "security": {
    "read_only": true,
    "allowed_http_methods": ["GET", "POST"],
    "read_only_post_routes": [
      "/api/v1/derivatives/options/surface",
      "/api/v1/econometrics/*",
      "/api/v1/quantitative/*",
      "/api/v1/technical/*",
      "/api/v1/uscongress/bill_text",
      "/api/v1/uscongress/amendment_text"
    ],
    "disabled_surfaces": ["skills", "prompts", "resources", "package_install", "trading"]
  },
  "providerless_tool_policy": {
    "local_tools": [
      "coverage_command_model",
      "coverage_commands",
      "coverage_providers",
      "derivatives_options_surface",
      "econometrics_autocorrelation",
