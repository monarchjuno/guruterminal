{
  "id": "econdb.macro",
  "name": "EconDB",
  "summary": "International macroeconomic datasets through the bundled OpenBB runtime.",
  "publisher": "OpenBB",
  "data_authority": "EconDB",
  "kind": "data_source",
  "free_state": "free_account",
  "trust": "first_party",
  "runtime": {
    "kind": "mcp",
    "server_id": "openbb",
    "provider_ids": [
      "econdb"
    ],
    "credential_mapping": {
      "api_key": "econdb_api_key"
    },
    "config_mapping": {},
    "verification_probe": {
      "tool_name": "economy_country_profile",
      "arguments": {
        "country": "US",
        "provider": "econdb"
      }
    }
  },
  "release_stage": "available",
  "featured": false,
  "markets": [
    "Global"
  ],
  "asset_classes": [
    "Macroeconomic"
  ],
  "capabilities": [
    "macro.series",
    "macro.country_profile"
  ],
  "freshness": [
    "Periodic",
    "Historical"
  ],
  "attribution": "EconDB via OpenBB",
  "terms_url": "https://www.econdb.com/api/",
  "permissions": {
    "network_hosts": [
      "www.econdb.com"
    ],
    "credential_kinds": [
      "api_key"
    ]
  },
  "setup": {
    "config_fields": [],
    "credential_fields": [
      {
        "id": "api_key",
        "kind": "api_key",
        "options": [],
        "label": "EconDB API key",
        "required": true,
        "min_length": 8,
        "max_length": 512,
        "help_url": "https://www.econdb.com/api/"
      }
    ]
  }
}
