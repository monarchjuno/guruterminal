{
  "id": "benzinga.news",
  "name": "Benzinga",
  "summary": "Market news and corporate events through the bundled OpenBB runtime.",
  "publisher": "OpenBB",
  "data_authority": "Benzinga",
  "kind": "data_source",
  "free_state": "paid",
  "trust": "first_party",
  "runtime": {
    "kind": "mcp",
    "server_id": "openbb",
    "provider_ids": [
      "benzinga"
    ],
    "credential_mapping": {
      "api_key": "benzinga_api_key"
    },
    "config_mapping": {},
    "verification_probe": {
      "tool_name": "news_world",
      "arguments": {
        "limit": 1,
        "provider": "benzinga"
      }
    }
  },
  "release_stage": "available",
  "featured": false,
  "markets": [
    "Global"
  ],
  "asset_classes": [
    "Multi-asset"
  ],
  "capabilities": [
    "company.news",
    "market.news"
  ],
  "freshness": [
    "Current"
  ],
  "attribution": "Benzinga via OpenBB",
  "terms_url": "https://www.benzinga.com/apis/",
  "permissions": {
    "network_hosts": [
      "api.benzinga.com"
    ],
    "credential_kinds": [
      "api_key"
    ]
  },
  "setup": {
    "config_fields": [],
    "credential_fields": [
      {
        "id": "api_key",
        "kind": "api_key",
        "options": [],
        "label": "Benzinga API key",
        "required": true,
        "min_length": 8,
        "max_length": 512,
        "help_url": "https://www.benzinga.com/apis/"
      }
    ]
  }
}
