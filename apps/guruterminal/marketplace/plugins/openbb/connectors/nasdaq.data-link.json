{
  "id": "nasdaq.data-link",
  "name": "Nasdaq Data Link",
  "summary": "Nasdaq datasets through OpenBB; a key unlocks authenticated datasets and higher limits.",
  "publisher": "OpenBB",
  "data_authority": "Nasdaq Data Link",
  "kind": "data_source",
  "free_state": "free_account",
  "trust": "first_party",
  "runtime": {
    "kind": "mcp",
    "server_id": "openbb",
    "provider_ids": [
      "nasdaq"
    ],
    "credential_mapping": {
      "api_key": "nasdaq_api_key"
    },
    "config_mapping": {},
    "verification_probe": {
      "tool_name": "equity_search",
      "arguments": {
        "query": "AAPL",
        "provider": "nasdaq"
      }
    }
  },
  "release_stage": "available",
  "featured": false,
  "markets": [
    "Global"
  ],
  "asset_classes": [
    "Multi-asset"
  ],
  "capabilities": [
    "entity.search",
    "market.datasets"
  ],
  "freshness": [
    "Current",
    "Historical"
  ],
  "attribution": "Nasdaq Data Link via OpenBB",
  "terms_url": "https://docs.data.nasdaq.com/",
  "permissions": {
    "network_hosts": [
      "api.nasdaq.com",
      "data.nasdaq.com",
      "www.nasdaq.com"
    ],
    "credential_kinds": [
      "api_key"
    ]
  },
  "setup": {
    "config_fields": [],
    "credential_fields": [
      {
        "id": "api_key",
        "kind": "api_key",
        "options": [],
        "label": "Nasdaq Data Link API key",
        "required": true,
        "min_length": 8,
        "max_length": 512,
        "help_url": "https://data.nasdaq.com/sign-up"
      }
    ]
  }
}
