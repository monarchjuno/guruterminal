{
  "id": "fred.macro",
  "name": "FRED",
  "summary": "US and international economic series from the St. Louis Fed. Free personal key.",
  "publisher": "Guru Terminal",
  "data_authority": "Federal Reserve Bank of St. Louis",
  "kind": "data_source",
  "free_state": "free_account",
  "trust": "first_party",
  "runtime": {
    "kind": "mcp",
    "server_id": "openbb",
    "provider_ids": [
      "fred"
    ],
    "credential_mapping": {
      "api_key": "fred_api_key"
    },
    "config_mapping": {},
    "verification_probe": {
